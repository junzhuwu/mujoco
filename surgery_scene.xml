<mujoco model="piper_surgery_room"> 
  <statistic center="1.0 0 1.0" extent="5.0"/> 

  <option timestep="0.001" integrator="implicit" gravity="0 0 -9.81">
    <flag energy="enable" contact="enable"/>
  </option>

  <visual> 
    <headlight diffuse="0.4 0.4 0.4" ambient="0.2 0.2 0.2" specular="0.1 0.1 0.1"/> 
    <rgba haze="0.15 0.25 0.35 1"/> 
    <global azimuth="140" elevation="-25"/> 
    <quality shadowsize="1024"/>
  </visual> 

  <default>
    <joint armature="1.0" damping="200" limited="true" frictionloss="5.0"/>
    <geom contype="1" conaffinity="1" condim="3" rgba="0.9 0.9 0.9 1" type="capsule" solref="0.01 1" solimp="0.99 0.99 0.001"/>
    <position kp="500" kv="100" ctrlrange="-180 180" forcerange="-200 200"/>
  </default>

  <asset> 
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.8 1.0" rgb2="0.1 0.1 0.2" width="512" height="3072"/> 
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.8 0.8 0.8" rgb2="0.7 0.7 0.7" 
      markrgb="0.9 0.9 0.9" width="300" height="300"/> 
    <material name="floor_mat" texture="groundplane" texuniform="true" texrepeat="2 2" reflectance="0.6" shininess="0.8"/>
    <material name="wall_mat" rgba="0.9 0.95 1.0 1" reflectance="0.1"/>
    <material name="cabinet_mat" rgba="0.2 0.4 0.5 1" reflectance="0.3"/>
    <material name="table_metal" rgba="0.7 0.7 0.7 1" reflectance="0.8"/>
    <material name="surgical_blue" rgba="0.2 0.5 0.8 1"/>
    <material name="chair_leather" rgba="0.1 0.1 0.1 1"/>
  </asset> 

  <worldbody> 
    <!-- Lighting -->
    <light pos="0.6 0 2.5" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" directional="true"/> 
    
    <!-- Room -->
    <geom name="floor" size="4 4 0.1" pos="0 0 -0.05" type="plane" material="floor_mat"/> 
    <geom name="wall_back" type="box" size="0.05 4 2" pos="-2 0 2" material="wall_mat"/>
    <geom name="wall_left" type="box" size="4 0.05 2" pos="2 4 2" material="wall_mat"/>
    <geom name="wall_right" type="box" size="4 0.05 2" pos="2 -4 2" material="wall_mat"/>
    <geom name="ceiling" type="box" size="4 4 0.05" pos="2 0 4" material="wall_mat"/>

    <!-- Cabinets and Equipment -->
    <body name="cabinet_1" pos="-1.8 2.5 1">
      <geom type="box" size="0.2 1.0 1.0" material="cabinet_mat"/>
      <geom type="box" size="0.21 0.9 0.1" pos="0 0 0.5" rgba="0.8 0.8 0.8 1"/>
      <geom type="box" size="0.21 0.9 0.1" pos="0 0 -0.5" rgba="0.8 0.8 0.8 1"/>
    </body>

    <body name="instrument_cart" pos="-1.5 -2.0 0.4">
      <geom type="box" size="0.3 0.4 0.4" rgba="0.7 0.7 0.7 1"/>
      <geom type="cylinder" size="0.05 0.02" pos="0.2 0.3 -0.4" rgba="0.2 0.2 0.2 1"/>
      <geom type="cylinder" size="0.05 0.02" pos="-0.2 0.3 -0.4" rgba="0.2 0.2 0.2 1"/>
      <geom type="cylinder" size="0.05 0.02" pos="0.2 -0.3 -0.4" rgba="0.2 0.2 0.2 1"/>
      <geom type="cylinder" size="0.05 0.02" pos="-0.2 -0.3 -0.4" rgba="0.2 0.2 0.2 1"/>
    </body>

    <!-- Monitor Arm -->
    <body name="monitor_base" pos="2.5 2.5 3.5">
      <geom type="cylinder" size="0.05 0.5" pos="0 0 -0.5" material="table_metal"/>
      <body name="monitor_arm1" pos="0 0 -0.5">
        <joint type="hinge" axis="0 0 1" range="-90 90"/>
        <geom type="capsule" size="0.03" fromto="0 0 0 0 -1.0 0" material="table_metal"/>
        <body name="monitor_screen" pos="0 -1.0 0">
          <joint type="hinge" axis="0 1 0" range="-45 45"/>
          <geom type="box" size="0.4 0.02 0.3" rgba="0.1 0.1 0.1 1"/>
          <geom name="screen_display" type="box" size="0.38 0.001 0.28" pos="0 -0.021 0" rgba="0 0.8 1 1"/>
        </body>
      </body>
    </body>

    <!-- Operating Table -->
    <body name="operating_table" pos="1.2 0 0.6">
      <geom name="table_base" type="box" size="0.15 0.15 0.5" pos="0 0 -0.5" material="table_metal"/>
      <geom name="table_top" type="box" size="0.4 1.2 0.05" material="surgical_blue"/>
      <geom name="rail_left" type="capsule" size="0.01 1.1" pos="0.41 0 0" quat="0.707 0.707 0 0" material="table_metal"/>
      <geom name="rail_right" type="capsule" size="0.01 1.1" pos="-0.41 0 0" quat="0.707 0.707 0 0" material="table_metal"/>
      <body name="patient" pos="0 0 0.1">
        <geom name="patient_body" type="capsule" size="0.15 0.6" quat="0.707 0.707 0 0" rgba="0.95 0.85 0.75 1"/>
        <geom name="surgical_drape" type="box" size="0.42 0.7 0.02" pos="0 -0.1 0.15" rgba="0.1 0.3 0.5 0.9"/>
      </body>
    </body>

    <!-- Robot Base Stand -->
    <body name="robot_stand" pos="0 0 0.6">
      <geom name="stand_geom" type="cylinder" size="0.1 0.6" pos="0 0 -0.6" material="table_metal" contype="0" conaffinity="0"/>
      
      <!-- Piper Arm - Forced initial pose using 'ref' and 'pos' -->
      <body name="piper_base" pos="0 0 0.01">
        <geom name="base_link" type="cylinder" size="0.06 0.05" pos="0 0 0.025" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>
        <body name="link1" pos="0 0 0.05">
          <joint name="joint1" axis="0 0 1" range="-180 180" damping="100"/>
          <geom name="l1_cap" type="cylinder" size="0.05 0.04" pos="0 0 0.04" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0"/>
          <body name="link2" pos="0 0 0.08">
            <!-- 45 degree bend -->
            <joint name="joint2" axis="0 1 0" range="-90 90" ref="45" damping="200"/>
            <geom name="l2_cap" size="0.04" fromto="0 0 0 0 0 0.2" rgba="0.9 0.9 0.9 1" contype="0" conaffinity="0"/>
            <body name="link3" pos="0 0 0.2">
              <!-- 90 degree bend -->
              <joint name="joint3" axis="0 1 0" range="-150 150" ref="90" damping="150"/>
              <geom name="l3_cap" size="0.035" fromto="0 0 0 0 0 0.18" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0"/>
              <body name="link4" pos="0 0 0.18">
                <joint name="joint4" axis="1 0 0" range="-180 180" damping="100"/>
                <geom name="l4_cap" size="0.03" fromto="0 0 0 0.1 0 0" rgba="0.9 0.9 0.9 1" contype="0" conaffinity="0"/>
                <body name="link5" pos="0.1 0 0">
                  <joint name="joint5" axis="0 1 0" range="-120 120" ref="45" damping="100"/>
                  <geom name="l5_cap" size="0.025" fromto="0 0 0 0.05 0 0" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0"/>
                  <body name="link6" pos="0.05 0 0">
                    <joint name="joint6" axis="1 0 0" range="-180 180" damping="50"/>
                    <geom name="l6_cap" size="0.02" type="sphere" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>
                    <!-- Gripper with collision disabled to avoid jitter -->
                    <body name="left_finger" pos="0.02 0.01 0">
                      <joint name="finger_joint" axis="0 0 1" range="0 0.04" type="slide" damping="50"/>
                      <geom name="f1" type="box" size="0.02 0.005 0.01" pos="0.02 0 0" rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0"/>
                    </body>
                    <body name="right_finger" pos="0.02 -0.01 0">
                      <joint name="finger_joint_r" axis="0 0 -1" range="0 0.04" type="slide" damping="50"/>
                      <geom name="f2" type="box" size="0.02 0.005 0.01" pos="0.02 0 0" rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Lights -->
    <body name="pendant_light_1" pos="0.8 0.6 2.2">
      <geom type="cylinder" size="0.3 0.03" rgba="0.9 0.9 1 1"/>
      <light pos="0 0 -0.1" dir="0 0 -1" diffuse="1 1 1" specular="1 1 1" exponent="20" cutoff="45"/>
    </body>
    <body name="pendant_light_2" pos="0.8 -0.6 2.2">
      <geom type="cylinder" size="0.3 0.03" rgba="0.9 0.9 1 1"/>
      <light pos="0 0 -0.1" dir="0 0 -1" diffuse="1 1 1" specular="1 1 1" exponent="20" cutoff="45"/>
    </body>
    <body name="ambient_light" pos="2 0 3.5">
      <light pos="0 0 0" dir="0 0 -1" diffuse="0.3 0.3 0.3" specular="0 0 0" directional="true"/>
    </body>
  </worldbody> 

  <actuator>
    <position name="a1" joint="joint1" kp="500" kv="100"/>
    <position name="a2" joint="joint2" kp="800" kv="200"/>
    <position name="a3" joint="joint3" kp="600" kv="150"/>
    <position name="a4" joint="joint4" kp="300" kv="80"/>
    <position name="a5" joint="joint5" kp="300" kv="80"/>
    <position name="a6" joint="joint6" kp="100" kv="30"/>
    <position name="a_finger" joint="finger_joint" kp="500" kv="50"/>
    <position name="a_finger_r" joint="finger_joint_r" kp="500" kv="50"/>
  </actuator>

  <contact>
    <!-- Disable ALL robot self-collisions to ensure absolute stability -->
    <exclude body1="piper_base" body2="link1"/>
    <exclude body1="piper_base" body2="link2"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="link6"/>
    <exclude body1="link6" body2="left_finger"/>
    <exclude body1="link6" body2="right_finger"/>
  </contact>
</mujoco>
